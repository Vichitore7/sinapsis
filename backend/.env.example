# Copia este archivo a .env (NO subas .env al repositorio)
# mock = sin IA, costo $0 | claude = usa la API de Anthropic
THINKLOOP_AI_PROVIDER=mock
# Modelo por defecto: claude-opus-5-5. Alternativa más barata para pruebas: claude-haiku-5-5
THINKLOOP_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# 1 = permite simular "regresé tras N días" en la demo
THINKLOOP_DEMO=1
# PIN del panel docente (http://localhost:5173/#docente). Cámbialo fuera de la demo.
THINKLOOP_TEACHER_PIN=1234
